
{
  "ReverseProxy": {
    "Routes": {
      "clientes": {
        "ClusterId": "clientes",
        "Match": {
          "Path": "/clientes/{**catch-all}"
        }
      },
      "restaurantes": {
        "ClusterId": "restaurantes",
        "Match": {
          "Path": "/restaurantes/{**catch-all}"
        }
      },
      "pedidos": {
        "ClusterId": "pedidos",
        "Match": {
          "Path": "/pedidos/{**catch-all}"
        }
      },
      "pagamentos": {
        "ClusterId": "pagamentos",
        "Match": {
          "Path": "/pagamentos/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "clientes": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8081/"
          }
        }
      },
      "restaurantes": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8080/"
          }
        }
      },
      "pedidos": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8082/"
          }
        }
      },
      "pagamentos": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8083/"
          }
        }
      }
    }
  }
}
